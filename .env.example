# Metron environment template.
# Copy to .env and fill in real values. Never commit a real .env.
# Required variables are marked [REQUIRED]; METRON_SETTLEMENT_PRIVATE_KEY is optional.

# --- Persistence -------------------------------------------------------------

# Supabase-hosted PostgreSQL connection string. [REQUIRED]
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# --- Redis / Upstash (ephemeral state only) ---------------------------------

UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_REST_TOKEN

# --- Server secrets ----------------------------------------------------------

# Long random string for signing session cookies. [REQUIRED]
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# 32-byte hex (64 hex chars) key for encrypting upstream credentials at rest. [REQUIRED]
UPSTREAM_SECRET_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# --- Public (safe for browser bundles) ---------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=REPLACE_WITH_PROJECT_ID

# --- Celo Mainnet ------------------------------------------------------------

CELO_CHAIN_ID=42220
CELO_NETWORK=eip155:42220
CELO_USDC_ADDRESS=0xcEBA9300f2b948710d2653dD7B07f33A8B32118C
CELO_RPC_URL=https://forno.celo.org

# --- x402 facilitator --------------------------------------------------------

X402_FACILITATOR_URL=https://api.x402.celo.org
X402_API_KEY=REPLACE_WITH_SERVER_SIDE_KEY
# Settlement money switch. Keep false/absent; only set true for the manual
# settlement test, then immediately return to false.
X402_SETTLEMENT_ENABLED=false
# Payout money switch. Keep false/absent; only set true for the manual
# creator-payout test, then immediately return to false.
PAYOUTS_ENABLED=false

# --- Metron settlement wallet and attribution --------------------------------

METRON_SETTLEMENT_WALLET=0x21E5Fc03E4305CC8CFb874253c6d66A8bdB0bcDa
# Optional for M0. Server-side secret; never expose or commit.
# METRON_SETTLEMENT_PRIVATE_KEY=
CELO_ATTRIBUTION_TAG=celo_91fed90b97fc
